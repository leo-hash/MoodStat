<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="moodstat.MainActivity">

    <Button
        android:id="@+id/btn_statistic"
        android:layout_width="313dp"
        android:layout_height="132dp"
        android:layout_marginStart="49dp"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="49dp"
        android:layout_marginBottom="39dp"
        android:text="Statistic PlaceHolder"
        app:layout_constraintBottom_toTopOf="@id/btn_daily_report"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btn_daily_report"
        android:layout_width="311dp"
        android:layout_height="120dp"
        android:layout_marginStart="49dp"
        android:layout_marginTop="108dp"
        android:layout_marginEnd="49dp"
        android:text="Daily report Placeholder"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_statistic" />
</androidx.constraintlayout.widget.ConstraintLayout>